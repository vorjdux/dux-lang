// Efficient string building: collect parts into a list then join in one allocation.
// This avoids the O(n²) copying of the naive s = s + "x" approach.
extern "C" void duxrt_list_push(ptr l, ptr val)
extern "C" ptr duxrt_str_join_list(ptr parts, long count)
extern "C" void duxrt_list_free(ptr l)

int main() {
    list parts = []
    long N = 50000l
    long i = 0l
    while i < N {
        unsafe {
            duxrt_list_push(parts, "x")
        }
        i = i + 1l
    }
    str result = ""
    unsafe {
        result = duxrt_str_join_list(parts, N)
        duxrt_list_free(parts)
    }
    println(len(result))
    return 0
}
