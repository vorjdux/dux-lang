# Closures — first-class fn types with lexical capture

# Higher-order function accepting fn(int) -> int
int apply(fn(int) -> int f, int x) {
    return f(x)
}

int main() {
    # Lambda stored in a variable — auto + explicit return type
    auto sq = fn(int n) -> int => n * n
    println(sq(5))
    println(sq(7))

    # Closure capturing a local variable
    int base = 100
    auto addBase = fn(int n) -> int => n + base
    println(addBase(7))
    println(addBase(50))

    # Passing a lambda to a higher-order function
    println(apply(sq, 4))
    println(apply(addBase, 3))

    # Multi-statement lambda body (block form; closing } must be on its own line)
    auto greet = fn(str name) -> void {
        str msg = "hello, " + name
        println(msg)
    }
    greet("world")
    greet("dux")

    # Closures capturing different locals
    int offset10 = 10
    int offset20 = 20
    auto add10 = fn(int n) -> int => n + offset10
    auto add20 = fn(int n) -> int => n + offset20
    println(add10(5))
    println(add20(5))

    # Two-argument lambda
    auto add = fn(int x, int y) -> int => x + y
    println(add(3, 4))
    println(add(10, 20))

    return 0
}
