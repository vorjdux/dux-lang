# Closures — first-class fn types with lexical capture

# Higher-order function accepting fn(int) -> int
int apply(fn(int) -> int f, int x) {
    return f(x)
}

int main() {
    # Style A: return type inside the lambda, auto on the left
    auto sq = fn(int n) -> int => n * n
    println(sq(5))
    println(sq(7))

    # Style B: return type as the variable prefix, lambda is untyped
    int sq2 = fn(int n) => n * n
    println(sq2(5))
    println(sq2(7))

    # Block body — Style A
    auto cube = fn(int n) -> int {
        return n * n * n
    }
    println(cube(3))

    # Block body — Style B
    int cube2 = fn(int n) {
        return n * n * n
    }
    println(cube2(3))

    # Closures capturing a local variable
    int base = 100
    auto addBase = fn(int n) -> int => n + base
    int  addBase2 = fn(int n) => n + base
    println(addBase(7))
    println(addBase2(7))

    # Passing lambdas to higher-order functions
    println(apply(sq, 4))
    println(apply(sq2, 4))

    # Multi-statement block body
    auto greet = fn(str name) -> void {
        str msg = "hello, " + name
        println(msg)
    }
    greet("world")
    greet("dux")

    # Two-argument lambda
    auto add = fn(int x, int y) -> int => x + y
    int  add2 = fn(int x, int y) => x + y
    println(add(3, 4))
    println(add2(3, 4))

    return 0
}
