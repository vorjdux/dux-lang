void main() {
    # ── Explicit types ────────────────────────────────────────────────────────

    int    age   = 25
    long   big   = 9000000000
    double pi    = 3.14159
    real   temp  = 98.6
    str    name  = "Dux"
    bool   ok    = true

    println(age)
    println(big)
    println(pi)
    println(name)

    # ── Type inference with auto ───────────────────────────────────────────────

    auto age2  = 42            # int
    auto big2  = 9000000000l   # long  (l suffix → 64-bit)
    auto pi2   = 3.14159       # double
    auto temp2 = 98.6f         # real  (f suffix → 32-bit float)
    auto name2 = "Dux"         # str
    auto ok2   = true          # bool

    println(age2)
    println(big2)
    println(pi2)
    println(name2)

    # ── Literal suffixes ──────────────────────────────────────────────────────
    # Use suffixes to pin numeric width when auto would pick the wrong type.

    auto a = 42         # int    (default for bare integer literal)
    auto b = 42i        # int    (explicit — same as plain 42)
    auto c = 42l        # long   (64-bit signed integer)
    auto d = 3.14       # double (default for bare float literal)
    auto e = 3.14d      # double (explicit — same as plain 3.14)
    auto f = 3.14f      # real   (32-bit float)
    auto g = 42d        # double (42 as double: 42.0)
    auto h = 42f        # real   (42 as 32-bit float)

    println(a)
    println(b)
    println(c)
    println(d)
    println(f)
    println(g)

    # ── Constants — cannot be reassigned ─────────────────────────────────────

    const int MAX      = 100
    const str VERSION  = "1.0.0"

    println(MAX)
    println(VERSION)

    # ── Arithmetic ────────────────────────────────────────────────────────────

    int x = 10
    int y = 20
    int z = x + y
    println(z)
}
