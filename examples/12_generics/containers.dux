# Generics — parametric classes via monomorphisation

class Box<T> {
    T value

    Box(T v) {
        this.value = v
    }

    T unwrap() {
        return this.value
    }
}

# Optional — either holds a value or is empty
class Maybe<T> {
    T value
    bool has_value

    Maybe(T v) {
        this.value = v
        this.has_value = true
    }

    bool present() {
        return this.has_value
    }

    T value_of() {
        return this.value
    }
}

class Pair<A, B> {
    A first
    B second

    Pair(A a, B b) {
        this.first  = a
        this.second = b
    }

    A fst() {
        return this.first
    }

    B snd() {
        return this.second
    }
}

int main() {
    # Box — wrap any single value
    Box<int> bi = new Box<int>(42)
    println(bi.unwrap())

    Box<str> bs = new Box<str>("hello")
    println(bs.unwrap())

    Box<double> bd = new Box<double>(3.14)
    println(bd.unwrap())

    # Maybe — optional value
    Maybe<int> some = new Maybe<int>(7)
    if some.present() {
        println(some.value_of())
    }

    Maybe<str> word = new Maybe<str>("dux")
    if word.present() {
        println(word.value_of())
    }

    # Pair — two heterogeneous values
    Pair<int, str> p = new Pair<int, str>(7, "seven")
    println(p.fst())
    println(p.snd())

    Pair<str, int> q = new Pair<str, int>("ten", 10)
    println(q.fst())
    println(q.snd())

    return 0
}
