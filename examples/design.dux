namespace com.vorjdux.lang {

    # Comment single line test

    const str name = "Matheus Santos"
    real valor = 0.0
    double dvalor = 0.0
    list names = []

    dict people = {
        "nome": name,
    }

    tuple coordinates = [22, 23]

    """
        Comment multline test 1
        ~!@#$%^&*()_+=-{}[]|\:;'`/.,<>?
        Comment multline test 2 / *
        Comment multline test 3 //
        Comment multline test 4 /*
        Comment multline test 5
    """

    interface IPerson() {
        public:
        int burn_year()
        str set_name(str name, int age)
    }

    class Hand()

    class Person(public object, private IPerson) {

        public:

        Person() {
            this._age = 0
            this._hand = new Hand()
        }

        Person(str _name, int _age) {
            this._age = _age
            this._hand = new Hand()
        }

        ~Person() {
            delete this._hand
        }

        private:
        int _age = 33
        bool _live = false
        Hand _hand

        protected:
        void init(str _name) {
            this._name = _name
        }

        public:

        int burn_year() {
            const int year = 2024
            return year - this._age
        }

        int get_age() {
            return this._age
        }

    }

    class Animal() {

        int _age = 2

        public:

        Animal(str _name) {
            this._name = _name
        }

        int burn_year() {
            const int _year = 2024
            return _year - this._age
        }

    }

    void main() {

        Person _person = new Person()
        println(_person.burn_year())

        Animal _animal = new Animal("Buddy")
        println(_animal.burn_year())

        assert(2 + 2 == 4)

        println("Hi, my name is someone and I am old")

        str _text = "Hi, my name is someone"

        int a = 1
        int b = 2
        int total = 0

        total = a + b

        assert(total == 3)

        total++

        assert(total == 4)

        total--

        assert(total == 3)

        println(total)

        for int i in range(10) {
            println(i)
        }

        for int i in 0..<5 {
            println(i)
        }

        for int i = 0, i < 5, i++ {
            println(i)
        }

        int i = 0

        do {
            i++
        } while i < 10

        switch i {
            case 1:
                println("It is the number one")
                break
            case 10:
                println("It is ten!")
                break
            default:
                println("I don't know")
        }

        int j = 0

        try {

            &label1 while true {

                int k = 0

                println(k)

                k++

                while k < 10 {

                    if k == 5 {
                        break &label1
                    } else {
                        j++
                    }

                    k++
                }

                if k == 10 {
                    break
                }

            }

        } catch ... {
            println("Error")
        }

        println("done")

    }

