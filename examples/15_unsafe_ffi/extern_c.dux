# Unsafe blocks and extern "C" — C FFI

# Declare C runtime functions directly
extern "C" double duxrt_math_sqrt(double x)
extern "C" double duxrt_math_pow(double base, double exp)
extern "C" double duxrt_math_abs_d(double x)
extern "C" void   duxrt_println_str(ptr s)

# Thin Dux wrappers around the extern declarations
double my_sqrt(double x) {
    double result
    unsafe {
        result = duxrt_math_sqrt(x)
    }
    return result
}

double my_pow(double base, double exp) {
    double result
    unsafe {
        result = duxrt_math_pow(base, exp)
    }
    return result
}

double my_abs(double x) {
    double result
    unsafe {
        result = duxrt_math_abs_d(x)
    }
    return result
}

int main() {
    println(my_sqrt(9.0))
    println(my_sqrt(2.0))

    println(my_pow(2.0, 10.0))
    println(my_pow(3.0, 3.0))

    println(my_abs(-5.5))
    println(my_abs(3.14))

    # ptr type: raw opaque pointer (alias for object)
    ptr raw = null
    unsafe {
        raw = null
    }
    println("ffi ok")

    return 0
}
