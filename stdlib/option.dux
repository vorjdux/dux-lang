# stdlib/option.dux — Option type (monomorphised over object until generics land)
#
# Represents an optional value: either Some(value) or None.
#
# Construction:
#   Option o = Option.Some("hello")
#   Option o = Option.None
#
# Pattern-matching (preferred):
#   match o {
#       Option.Some(val) => {
#           print(val)
#       }
#       Option.None => {
#           print("nothing")
#       }
#   }
#
# Helper functions:
#   option_is_some(o)        → bool
#   option_is_none(o)        → bool
#   option_unwrap(o)         → object  (throws PanicError on None)
#   option_unwrap_or(o, def) → object  (returns def on None)

enum Option {
    None,
    Some(object)
}

# ── Predicates ────────────────────────────────────────────────────────────────

bool option_is_some(Option o) {
    match o {
        Option.Some(v) => {
            return true
        }
        Option.None => {
            return false
        }
    }
    return false
}

bool option_is_none(Option o) {
    match o {
        Option.None => {
            return true
        }
        Option.Some(v) => {
            return false
        }
    }
    return true
}

# ── Unwrap ────────────────────────────────────────────────────────────────────

# PanicError is thrown by option_unwrap when called on None.
class PanicError(object) {
    str message
    PanicError(str msg) {
        this.message = msg
    }
}

# Return the contained value. Throws PanicError if the option is None.
object option_unwrap(Option o) {
    match o {
        Option.Some(val) => {
            return val
        }
        Option.None => {
            throw new PanicError("option_unwrap called on None")
        }
    }
    return null
}

# Return the contained value, or default_val if None.
object option_unwrap_or(Option o, object default_val) {
    match o {
        Option.Some(val) => {
            return val
        }
        Option.None => {
            return default_val
        }
    }
    return default_val
}
