import option

namespace env {
    extern "C" str  duxrt_env_fetch(str name) ;
    extern "C" str  duxrt_env_get(str name) ;
    extern "C" int  duxrt_env_has(str name) ;
    extern "C" int  duxrt_env_store(str name, str val) ;
    extern "C" int  duxrt_env_remove(str name) ;
    extern "C" list duxrt_env_all() ;

    # Fetch an environment variable as Option.
    # Returns Option.Some(value) if set, Option.None if not set.
    # This is the preferred API — use get() only when a fallback string is
    # more convenient than pattern-matching.
    Option fetch(str name) {
        int h = 0
        unsafe {
            h = duxrt_env_has(name)
        }
        if h != 0 {
            str r = ""
            unsafe {
                r = duxrt_env_get(name)
            }
            return Option.Some(r)
        }
        return Option.None
    }

    # Get environment variable value; returns "" if not set.
    # Prefer fetch() when you need to distinguish "not set" from "set to empty".
    str get(str name) {
        str r = ""
        unsafe {
            r = duxrt_env_get(name)
        }
        return r
    }

    # Get variable with fallback value when not set.
    str get_or(str name, str fallback) {
        int h = 0
        unsafe {
            h = duxrt_env_has(name)
        }
        if h != 0 {
            str r = ""
            unsafe {
                r = duxrt_env_get(name)
            }
            return r
        }
        return fallback
    }

    # True if environment variable is set.
    bool has(str name) {
        int r = 0
        unsafe {
            r = duxrt_env_has(name)
        }
        return r != 0
    }

    # Set environment variable. Returns true on success.
    bool store(str name, str val) {
        int r = 0
        unsafe {
            r = duxrt_env_store(name, val)
        }
        return r != 0
    }

    # Remove environment variable. Returns true on success.
    bool remove(str name) {
        int r = 0
        unsafe {
            r = duxrt_env_remove(name)
        }
        return r != 0
    }

    # All environment entries as "KEY=VALUE" strings.
    list all() {
        list r = []
        unsafe {
            r = duxrt_env_all()
        }
        return r
    }
}
