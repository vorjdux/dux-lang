namespace env {
    extern "C" str duxrt_env_fetch(str name) ;
    extern "C" int duxrt_env_has(str name) ;
    extern "C" int duxrt_env_store(str name, str val) ;
    extern "C" int duxrt_env_remove(str name) ;

    # Get environment variable value; returns "" if not set.
    str fetch(str name) {
        str r = ""
        unsafe {
            r = duxrt_env_fetch(name)
        }
        return r
    }

    # True if environment variable is set.
    bool has(str name) {
        int r = 0
        unsafe {
            r = duxrt_env_has(name)
        }
        return r != 0
    }

    # Set environment variable. Returns true on success.
    bool store(str name, str val) {
        int r = 0
        unsafe {
            r = duxrt_env_store(name, val)
        }
        return r != 0
    }

    # Remove environment variable. Returns true on success.
    bool remove(str name) {
        int r = 0
        unsafe {
            r = duxrt_env_remove(name)
        }
        return r != 0
    }
}
