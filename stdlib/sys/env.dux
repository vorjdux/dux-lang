// sys.env — environment variable access
//
// Import with:
//   import sys.env
//
// Usage:
//   let val = env.fetch("HOME")           // get env var → str (empty if not set)
//   let ok  = env.has("PATH")             // check existence → bool
//   let ok2 = env.store("MY_VAR", "1")   // set env var → bool
//   let ok3 = env.remove("MY_VAR")       // unset env var → bool
//
// Note: 'get' and 'set' are reserved words; use 'fetch'/'store' instead.
