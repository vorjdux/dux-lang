extern "C" ptr duxrt_str_concat(ptr a, ptr b)
extern "C" ptr duxrt_str_from_int(long n)
extern "C" ptr duxrt_str_from_double(double x)
extern "C" long duxrt_str_length(ptr s)
extern "C" ptr duxrt_str_slice(ptr s, long start, long end)

str concat(str a, str b) {
    return duxrt_str_concat(a, b)
}

str from_int(long n) {
    return duxrt_str_from_int(n)
}

str from_double(double x) {
    return duxrt_str_from_double(x)
}

long length(str s) {
    return duxrt_str_length(s)
}

str slice(str s, long start, long end) {
    return duxrt_str_slice(s, start, end)
}
