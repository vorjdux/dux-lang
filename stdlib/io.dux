extern "C" void duxrt_println_str(ptr s)
extern "C" void duxrt_print_str(ptr s)
extern "C" ptr duxrt_readline()

void println(str s) {
    unsafe {
        duxrt_println_str(s)
    }
}

void print(str s) {
    unsafe {
        duxrt_print_str(s)
    }
}

str readline() {
    str result = ""
    unsafe {
        result = duxrt_readline()
    }
    return result
}
