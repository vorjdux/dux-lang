namespace mutex {
    extern "C" ptr  duxrt_mutex_create() ;
    extern "C" void duxrt_mutex_lock(ptr mx) ;
    extern "C" void duxrt_mutex_unlock(ptr mx) ;
    extern "C" int  duxrt_mutex_trylock(ptr mx) ;
    extern "C" void duxrt_mutex_free(ptr mx) ;

    # Create a new mutex. Returns handle.
    ptr create() {
        ptr r = null
        unsafe {
            r = duxrt_mutex_create()
        }
        return r
    }

    # Lock a mutex (blocks until acquired).
    void lock(ptr m) {
        unsafe {
            duxrt_mutex_lock(m)
        }
    }

    # Unlock a mutex.
    void unlock(ptr m) {
        unsafe {
            duxrt_mutex_unlock(m)
        }
    }

    # Try to lock without blocking. Returns true if acquired.
    bool trylock(ptr m) {
        int r = 0
        unsafe {
            r = duxrt_mutex_trylock(m)
        }
        return r == 0
    }

    # Free mutex resources.
    void free(ptr m) {
        unsafe {
            duxrt_mutex_free(m)
        }
    }
}
