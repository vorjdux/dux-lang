import option
import result

namespace fs {
    extern "C" int  duxrt_fs_mkdir(str path) ;
    extern "C" int  duxrt_fs_mkdir_all(str path) ;
    extern "C" int  duxrt_fs_rmdir(str path) ;
    extern "C" int  duxrt_fs_remove(str path) ;
    extern "C" int  duxrt_fs_rename(str src, str dst) ;
    extern "C" list duxrt_fs_list_dir(str path) ;
    extern "C" str  duxrt_fs_cwd() ;
    extern "C" int  duxrt_fs_chdir(str path) ;
    extern "C" int  duxrt_fs_exists(str path) ;
    extern "C" int  duxrt_fs_is_dir(str path) ;
    extern "C" int  duxrt_fs_is_file(str path) ;
    extern "C" long duxrt_fs_size(str path) ;
    extern "C" long duxrt_fs_mtime(str path) ;
    extern "C" int  duxrt_fs_last_errno() ;
    extern "C" int  duxrt_fs_copy(str src, str dst) ;

    # Create a directory.
    bool mkdir(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_mkdir(p)
        }
        return r == 0
    }

    # Create directory with all parent directories.
    bool mkdir_all(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_mkdir_all(p)
        }
        return r == 0
    }

    # Remove an empty directory.
    bool rmdir(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_rmdir(p)
        }
        return r == 0
    }

    # Remove a file.
    bool remove(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_remove(p)
        }
        return r == 0
    }

    # Rename or move a file/directory.
    bool rename(str src, str dst) {
        int r = 0
        unsafe {
            r = duxrt_fs_rename(src, dst)
        }
        return r == 0
    }

    # List directory entries (excluding . and ..).
    list list_dir(str p) {
        list result = []
        unsafe {
            result = duxrt_fs_list_dir(p)
        }
        return result
    }

    # Current working directory.
    str cwd() {
        str r = ""
        unsafe {
            r = duxrt_fs_cwd()
        }
        return r
    }

    # Change working directory.
    bool chdir(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_chdir(p)
        }
        return r == 0
    }

    # True if path exists.
    bool exists(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_exists(p)
        }
        return r != 0
    }

    # True if path is a directory.
    bool is_dir(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_is_dir(p)
        }
        return r != 0
    }

    # True if path is a regular file.
    bool is_file(str p) {
        int r = 0
        unsafe {
            r = duxrt_fs_is_file(p)
        }
        return r != 0
    }

    # File size in bytes; -1 if not a file or error.
    long size(str p) {
        long r = 0
        unsafe {
            r = duxrt_fs_size(p)
        }
        return r
    }

    # Last-modified time as Unix seconds; -1 on error.
    long mtime(str p) {
        long r = 0
        unsafe {
            r = duxrt_fs_mtime(p)
        }
        return r
    }

    # Copy a file. Returns true on success.
    bool copy(str src, str dst) {
        int r = 0
        unsafe {
            r = duxrt_fs_copy(src, dst)
        }
        return r == 0
    }

    # errno from the last failed fs operation.
    int last_errno() {
        int r = 0
        unsafe {
            r = duxrt_fs_last_errno()
        }
        return r
    }

    # Stat: snapshot of file/directory metadata.
    class Stat {
        str  path
        bool is_file
        bool is_dir
        long size
        long mtime

        Stat(str p, bool f, bool d, long s, long m) {
            this.path    = p
            this.is_file = f
            this.is_dir  = d
            this.size    = s
            this.mtime   = m
        }
    }

    # Return a Stat for the given path, or null if it does not exist.
    # For code that prefers ADT-style error handling, use stat_opt() instead.
    Stat stat(str p) {
        int ex = 0
        unsafe {
            ex = duxrt_fs_exists(p)
        }
        if ex == 0 {
            return null
        }
        int fi = 0
        int di = 0
        long s = 0
        long m = 0
        unsafe {
            fi = duxrt_fs_is_file(p)
            di = duxrt_fs_is_dir(p)
            s  = duxrt_fs_size(p)
            m  = duxrt_fs_mtime(p)
        }
        bool f = fi != 0
        bool d = di != 0
        return new Stat(p, f, d, s, m)
    }

    # Return Option.Some(Stat) for the given path, or Option.None if it does
    # not exist.  Preferred over stat() when you want to pattern-match:
    #
    #   match fs.stat_opt("/etc/hosts") {
    #       Option.Some(s) => { print("found") }
    #       Option.None    => { print("not found") }
    #   }
    Option stat_opt(str p) {
        int ex = 0
        unsafe {
            ex = duxrt_fs_exists(p)
        }
        if ex == 0 {
            return Option.None
        }
        int fi = 0
        int di = 0
        long s = 0
        long m = 0
        unsafe {
            fi = duxrt_fs_is_file(p)
            di = duxrt_fs_is_dir(p)
            s  = duxrt_fs_size(p)
            m  = duxrt_fs_mtime(p)
        }
        bool f = fi != 0
        bool d = di != 0
        Stat st = new Stat(p, f, d, s, m)
        return Option.Some(st)
    }

    # List directory entries, returning Result.Ok(entries) or Result.Err(message).
    # Preferred over list_dir() when you need to handle missing/inaccessible dirs.
    Result list_dir_result(str p) {
        int ex = 0
        int is_d = 0
        unsafe {
            ex   = duxrt_fs_exists(p)
            is_d = duxrt_fs_is_dir(p)
        }
        if ex == 0 {
            return Result.Err("directory not found: " + p)
        }
        if is_d == 0 {
            return Result.Err("not a directory: " + p)
        }
        list entries = []
        unsafe {
            entries = duxrt_fs_list_dir(p)
        }
        return Result.Ok(entries)
    }

    # Current working directory as Result.Ok(path) or Result.Err(message).
    Result cwd_result() {
        str r = ""
        unsafe {
            r = duxrt_fs_cwd()
        }
        if r == "" {
            return Result.Err("getcwd failed")
        }
        return Result.Ok(r)
    }
}
