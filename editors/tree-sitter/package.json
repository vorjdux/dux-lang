{
  "name": "tree-sitter-dux",
  "version": "0.1.3",
  "description": "Tree-sitter grammar for the Dux programming language",
  "main": "bindings/node",
  "keywords": [
    "parser",
    "tree-sitter",
    "dux"
  ],
  "author": "Dux Language Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dux-lang/dux-lang.git",
    "directory": "editors/tree-sitter"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/",
    "src/",
    "queries/"
  ],
  "dependencies": {
    "nan": "*"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "build": "node-gyp build",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "tree-sitter": [
    {
      "scope": "source.dux",
      "file-types": [
        "dux"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ]
}
