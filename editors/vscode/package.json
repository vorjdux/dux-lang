{
  "name": "dux-lang",
  "displayName": "Dux Language",
  "description": "Syntax highlighting, snippets, and language support for the Dux programming language",
  "version": "0.1.3",
  "publisher": "dux-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vorjdux/dux-lang"
  },
  "bugs": {
    "url": "https://github.com/vorjdux/dux-lang/issues"
  },
  "homepage": "https://github.com/vorjdux/dux-lang#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "dux",
    "dux-lang",
    "programming language",
    "syntax highlighting"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dux",
        "aliases": [
          "Dux",
          "dux"
        ],
        "extensions": [
          ".dux"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dux-light.svg",
          "dark": "./icons/dux-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dux",
        "scopeName": "source.dux",
        "path": "./syntaxes/dux.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dux",
        "path": "./snippets/dux.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.0.0",
    "ovsx": "^0.8.0",
    "typescript": "^5.0.0",
    "@types/vscode": "^1.70.0"
  }
}
