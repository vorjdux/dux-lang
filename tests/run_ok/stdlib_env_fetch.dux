import sys.env
import option

int main() {
    # PATH is always set on any POSIX system
    Option p = env.fetch("PATH")
    match p {
        Option.Some(v) => {
            print("path ok")
        }
        Option.None => {
            print("no PATH?")
        }
    }

    # Non-existent variable returns None
    Option missing = env.fetch("DUX_DEFINITELY_NOT_SET_XYZ987")
    match missing {
        Option.None => {
            print("none ok")
        }
        Option.Some(v) => {
            print("bad")
        }
    }

    # Set a variable, fetch it as Option, remove it
    env.store("DUX_FETCH_TEST", "world")
    Option fetched = env.fetch("DUX_FETCH_TEST")
    match fetched {
        Option.Some(v) => {
            print("fetched:" + v)
        }
        Option.None => {
            print("bad")
        }
    }
    env.remove("DUX_FETCH_TEST")

    # After removal it is None
    Option gone = env.fetch("DUX_FETCH_TEST")
    if option_is_none(gone) {
        print("removed ok")
    }

    print("env fetch ok")
    return 0
}
