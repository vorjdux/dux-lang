import net.tls

int main() {
    # Test TLS error function
    str e = tls.last_error()
    print("tls init ok")

    # A TlsConfig with non-existent files will fail gracefully
    TlsConfig cfg = new TlsConfig("/nonexistent.pem", "/nonexistent.key")
    if !cfg.is_valid() {
        print("invalid config ok")
    }

    print("tls ok")
    return 0
}
