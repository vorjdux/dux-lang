"""
  design.dux — integration test covering all major language features
"""

import math

# ── Generics ─────────────────────────────────────────────────────────────────

class Box<T> {
    T value

    Box(T v) {
        this.value = v
    }

    T unwrap() {
        return this.value
    }
}

class Pair<A, B> {
    A first
    B second

    Pair(A a, B b) {
        this.first  = a
        this.second = b
    }

    A fst() {
        return this.first
    }

    B snd() {
        return this.second
    }
}

# ── Operator overloading ──────────────────────────────────────────────────────

class Vec2 {
    int x
    int y

    Vec2(int x, int y) {
        this.x = x
        this.y = y
    }

    Vec2 operator__add(Vec2 other) {
        return new Vec2(this.x + other.x, this.y + other.y)
    }

    bool operator__eq(Vec2 other) {
        return this.x == other.x && this.y == other.y
    }

    int operator__index(int i) {
        if i == 0 {
            return this.x
        }
        return this.y
    }
}

# ── Inheritance ───────────────────────────────────────────────────────────────

class Animal() {
    int age

    Animal(int a) {
        this.age = a
    }

    int burn_year() {
        return 2025 - this.age
    }
}

class Dog(public Animal) {
    Dog(int a) : Animal(a) {
    }

    int burn_year() {
        return 2025 - this.age
    }
}

# ── RAII resource guard ───────────────────────────────────────────────────────

class Guard {
    Guard() {
        println("open")
    }

    ~Guard() {
        println("close")
    }
}

# ── Extern C / unsafe ─────────────────────────────────────────────────────────

extern "C" double duxrt_math_sqrt(double x)

double fast_sqrt(double x) {
    double result
    unsafe {
        result = duxrt_math_sqrt(x)
    }
    return result
}

# ── Higher-order functions ────────────────────────────────────────────────────

int apply(fn(int) -> int f, int x) {
    return f(x)
}

# ── Entry point ───────────────────────────────────────────────────────────────

int main() {

    Box<int> bi = new Box<int>(42)
    println(bi.unwrap())

    Box<str> bs = new Box<str>("hello")
    println(bs.unwrap())

    Pair<int, str> p = new Pair<int, str>(7, "seven")
    println(p.fst())
    println(p.snd())

    Vec2 a = new Vec2(1, 2)
    Vec2 b = new Vec2(3, 4)
    Vec2 c = a + b
    println(c.x)
    println(c.y)
    if c == new Vec2(4, 6) {
        println("eq")
    }
    println(a[0])

    Dog d = new Dog(3)
    println(d.burn_year())

    fn(int) -> int sq = fn(int n) => n * n
    println(sq(5))

    int base = 100
    fn(int) -> int addBase = fn(int n) => n + base
    println(addBase(7))

    println(apply(sq, 6))

    println(math.sqrt(2.0))

    println(fast_sqrt(9.0))

    for int i in range(3) {
        println(i)
    }

    for int i in 0..<3 {
        println(i)
    }

    int count = 0
    for int i = 0, i < 3, i++ {
        count++
    }
    println(count)

    int x = 0
    do {
        x++
    } while x < 3
    println(x)

    switch x {
        case 3:
            println("three")
            break
        default:
            println("other")
    }

    &outer while true {
        int k = 0
        while k < 5 {
            if k == 2 {
                break &outer
            }
            k++
        }
    }
    println("after break")

    try {
        throw new Vec2(0, 0)
    } catch ... {
        println("caught")
    }

    defer {
        println("defer:done")
    }

    Guard g = new Guard()

    assert(2 + 2 == 4)

    println("done")

    return 0
}
