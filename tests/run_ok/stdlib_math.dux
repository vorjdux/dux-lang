import math

int main() {
    # Constants
    double pi = math.PI()
    if pi > 3.14 and pi < 3.15 {
        print("PI ok")
    }
    if math.E() > 2.71 and math.E() < 2.72 {
        print("E ok")
    }
    if math.TAU() > 6.28 and math.TAU() < 6.29 {
        print("TAU ok")
    }
    if math.is_inf(math.INF()) {
        print("INF ok")
    }

    # Trigonometry
    double t = math.tan(pi / 4.0)
    if t > 0.99 and t < 1.01 {
        print("tan ok")
    }
    double at2 = math.atan2(1.0, 1.0)
    if at2 > 0.78 and at2 < 0.79 {
        print("atan2 ok")
    }
    double ac = math.acos(1.0)
    if ac > -0.01 and ac < 0.01 {
        print("acos ok")
    }
    double as_ = math.asin(0.0)
    if as_ > -0.01 and as_ < 0.01 {
        print("asin ok")
    }
    double at = math.atan(0.0)
    if at > -0.01 and at < 0.01 {
        print("atan ok")
    }

    # Exponential / logarithm
    double e1 = math.exp(1.0)
    if e1 > 2.71 and e1 < 2.72 {
        print("exp ok")
    }
    double e2 = math.exp2(3.0)
    if e2 > 7.99 and e2 < 8.01 {
        print("exp2 ok")
    }
    double l10 = math.log10(1000.0)
    if l10 > 2.99 and l10 < 3.01 {
        print("log10 ok")
    }

    # Rounding
    double tr = math.trunc(3.9)
    if tr > 2.99 and tr < 3.01 {
        print("trunc ok")
    }

    # Floating-point utilities
    double h = math.hypot(3.0, 4.0)
    if h > 4.99 and h < 5.01 {
        print("hypot ok")
    }
    double fm = math.fmod(10.0, 3.0)
    if fm > 0.99 and fm < 1.01 {
        print("fmod ok")
    }

    # Clamp
    double cl = math.clamp(15.0, 0.0, 10.0)
    if cl > 9.99 and cl < 10.01 {
        print("clamp ok")
    }
    long cli = math.clamp_i(15l, 0l, 10l)
    if cli == 10l {
        print("clamp_i ok")
    }

    # Sign
    int sg = math.sign(-7.0)
    if sg == -1 {
        print("sign ok")
    }
    int sgi = math.sign_i(-5l)
    if sgi == -1 {
        print("sign_i ok")
    }

    # Classification
    if math.is_nan(0.0 / 0.0) {
        print("is_nan ok")
    }
    if math.is_inf(1.0 / 0.0) {
        print("is_inf ok")
    }

    print("math ok")
    return 0
}
