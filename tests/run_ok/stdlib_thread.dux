import thread

int main() {
    Mutex m = new Mutex()
    m.lock()
    m.unlock()
    bool ok = m.try_lock()
    if ok {
        print("trylock ok")
        m.unlock()
    }
    print("mutex ok")

    RWLock rw = new RWLock()
    rw.read_lock()
    rw.unlock()
    rw.write_lock()
    rw.unlock()
    print("rwlock ok")

    CondVar cv = new CondVar()
    cv.signal()
    cv.broadcast()
    print("condvar ok")

    long id = thread.id()
    if id > 0 {
        print("thread id ok")
    }
    thread.sleep_ms(1)
    print("sleep ok")

    return 0
}
