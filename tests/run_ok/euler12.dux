import math

int factorCount(long n) {
    double square = math.sqrt(n)
    int isquare = square
    int count = 0
    for long candidate in 1..=isquare {
        if 0 == n % candidate {
            if candidate * candidate == n {
                count++
            } else {
                count += 2
            }
        }
    }
    return count
}

void main() {
    long triangle = 1
    int index = 1
    while factorCount(triangle) < 1001 {
        index++
        triangle += index
    }
    println(triangle)
}
