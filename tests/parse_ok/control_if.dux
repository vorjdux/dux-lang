# if / else if / else
void main() {
    x = 10
    if x > 5 {
        println("big")
    }

    if x > 5 {
        println("big")
    } else {
        println("small")
    }

    if x > 10 {
        println("very big")
    } else if x > 5 {
        println("medium")
    } else {
        println("small")
    }
}
