# Namespace declarations (no :: scope resolution in expressions yet)
namespace math {
    int abs(int x) {
        if x < 0 {
            return -x
        }
        return x
    }

    int max(int a, int b) {
        if a > b {
            return a
        }
        return b
    }
}

namespace io {
    void print(str s) {
        println(s)
    }
}
